DAEDALUS_ENV=development
DAEDALUS_DEMO_MODE=true
DAEDALUS_SESSION_SECRET=replace-with-a-long-random-value
DAEDALUS_DATABASE_URL=sqlite:///./data/daedalus.db
DAEDALUS_BASE_URL=http://127.0.0.1:8000
DAEDALUS_HOST=127.0.0.1
DAEDALUS_PORT=8000

# Optional Google OpenID Connect credentials. Keep the client secret server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Fernet key for encrypted integration credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DAEDALUS_ENCRYPTION_KEY=

# DNS audit only: optional comma-separated IP addresses (max three). Empty uses system DNS.
# This does not change website target validation or domain ownership verification.
DAEDALUS_AUDIT_DNS_NAMESERVERS=
