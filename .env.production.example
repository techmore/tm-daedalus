# Copy to .env.production and replace every example value before deployment.
DAEDALUS_ENV=production
DAEDALUS_DEMO_MODE=false
DAEDALUS_BASE_URL=https://daedalus.cybersecuritypilot.org
DAEDALUS_HOSTNAMES=daedalus.cybersecuritypilot.org
DAEDALUS_ALLOWED_HOSTS=daedalus.cybersecuritypilot.org
DAEDALUS_SESSION_SECRET=replace-with-at-least-32-random-characters
DAEDALUS_DATABASE_URL=sqlite:////data/daedalus.db
DAEDALUS_REPORTS_DIR=/data/reports
DAEDALUS_HOST=0.0.0.0
DAEDALUS_PORT=8000

# Use the canonical base URL's callback in Google's OAuth client settings:
# The configured Google OAuth client authorizes this callback URI:
# https://daedalus.cybersecuritypilot.org/oauth2/callback
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DAEDALUS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# DNS audit only: optional comma-separated IP addresses (max three). Empty uses system DNS.
# This does not change website target validation or domain ownership verification.
DAEDALUS_AUDIT_DNS_NAMESERVERS=

# Optional dedicated Google Admin audit project; use a separate Cloud project from login/Drive.
# Redirect: https://daedalus.cybersecuritypilot.org/auth/google-admin/callback
GOOGLE_ADMIN_CLIENT_ID=
GOOGLE_ADMIN_CLIENT_SECRET=

# Platform owners may approve 30-day complimentary onboarding; comma-separated Google account emails.
DAEDALUS_PLATFORM_ADMIN_EMAILS=
